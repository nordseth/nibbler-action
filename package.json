{
  "name": "nibbler-action",
  "version": "1.0.0",
  "description": "Github action for [Nibbler](https://github.com/nordseth/Nibbler)",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
    "build:login": "esbuild src/login.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/login/index.js",
    "build:metadata": "esbuild src/metadata.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/metadata/index.js",
    "build": "npm run typecheck && concurrently 'npm:build:main' 'npm:build:login' 'npm:build:metadata'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/webhooks-types": "^7.6.1",
    "detect-libc": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^6.28.0"
  }
}
